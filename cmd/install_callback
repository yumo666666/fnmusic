#!/bin/bash
set -e
export PATH="/var/apps/python312/target/bin:$PATH"
VENV_DIR="${TRIM_PKGVAR}/.venv"
SERVER_DIR="${TRIM_APPDEST}/server"
if [ ! -x "${VENV_DIR}/bin/python" ]; then
    python3 -m venv "${VENV_DIR}"
fi
"${VENV_DIR}/bin/pip" install --no-index --find-links "${SERVER_DIR}/wheels" -r "${SERVER_DIR}/requirements.txt"
CONFIG_FILE="${TRIM_PKGVAR}/config.json" \
MUSIC_DIR="${wizard_music_directory:-/vol2/1000/youtube/}" \
"${VENV_DIR}/bin/python" - <<'PY'
import json
import os
path = os.environ['CONFIG_FILE']
os.makedirs(os.path.dirname(path), exist_ok=True)
if os.path.exists(path):
    with open(path, encoding='utf-8') as f:
        config = json.load(f)
    if not isinstance(config, dict):
        raise ValueError('Existing configuration must be a JSON object')
else:
    config = {}
if 'music_directories' not in config and not config.get('music_directory'):
    config['music_directory'] = os.environ['MUSIC_DIR'].strip()
config.setdefault('port', 8090)
with open(path, 'w', encoding='utf-8') as f:
    json.dump(config, f, ensure_ascii=False, indent=2)
PY
